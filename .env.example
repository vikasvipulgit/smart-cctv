# Copy this file to .env and fill in what you use:   cp .env.example .env
# .env holds passwords and tokens - it is in .gitignore, never commit it.

# ---------- Cameras (referenced from backend/config/cameras.yaml as ${NAME}) ----------
# GATE_RTSP_URL=rtsp://admin:YOUR_PASSWORD@192.168.1.64:554/cam/realmonitor?channel=1&subtype=1

# ---------- Detection ----------
# yolo = real AI (downloads yolo11n.pt on first run) | mock = no AI, for testing with the synthetic camera
DETECTOR=yolo
YOLO_MODEL=yolo11n.pt
# auto picks mps (Apple Silicon GPU), cuda (NVIDIA) or cpu
DEVICE=auto
DETECTION_CONFIDENCE=0.4
# Phase 2: number plates (pip install -r backend/requirements-optional.txt)
PLATE_OCR=0
# Rules with "text_pattern" read numbers/text anywhere in the frame (EasyOCR, pip install easyocr).
# Seconds between reads per camera; OCR only runs while such a rule is enabled.
TEXT_OCR_INTERVAL=1.5
# Phase 3.5: CLIP semantic search (pip install -r backend/requirements-optional.txt)
EMBEDDINGS=0

# ---------- Alerts: Telegram (create a bot with @BotFather, get chat id from @userinfobot) ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- Alerts: Email ----------
# Gmail: SMTP_HOST=smtp.gmail.com, use an App Password (not your normal password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# ---------- Alerts: SMS via MSG91 (needs a DLT-approved template in India) ----------
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# comma separated, with country code: 919876543210
SMS_TO=

# Link used inside alert messages
PUBLIC_BASE_URL=http://localhost:5173

# ---------- Prompt search AI ----------
# none = built-in keyword parser | anthropic = Claude API | ollama = local model (ollama.com)
LLM_PROVIDER=none
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5vl:7b

# ---------- Web ----------
CORS_ORIGINS=http://localhost:5173
# DATABASE_URL=postgresql+psycopg://user:pass@localhost/smart_cctv
